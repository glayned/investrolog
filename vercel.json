{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://investrolog.pro/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "investrolog.vercel.app"
        }
      ]
    }
  ]
}
